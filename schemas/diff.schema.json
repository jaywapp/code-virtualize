{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-virtualize.dev/schemas/diff.schema.json",
  "title": "Code Virtualize diff contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline", "entries", "coverage", "limitations", "truncated", "nextCursor", "evidenceTruncated", "schema", "schemaVersion"],
  "properties": {
    "baseline": { "$ref": "common.schema.json#/$defs/baseline" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "coverage": { "$ref": "common.schema.json#/$defs/coverage" },
    "limitations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
    "truncated": { "type": "boolean" },
    "nextCursor": { "type": ["string", "null"] },
    "evidenceTruncated": {
      "type": "boolean",
      "description": "True when any entry's evidence was downgraded or trimmed by the diff evidence budget; when true, limitations must include diff-evidence-budget-exhausted. Independent of the entry-list truncated/nextCursor pagination."
    },
    "schema": { "const": "code-virtualize/diff" },
    "schemaVersion": { "const": 1 }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "description": "textualHunk (when present) is a unified diff using real file line numbers in its @@ hunk headers, not symbol-relative numbering.",
      "additionalProperties": false,
      "required": ["kind", "textMode", "textualHunk", "contextLines", "omittedBaseLines", "omittedTargetLines", "truncated", "baseContentHash", "targetContentHash"],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "textMode": { "enum": ["line_hunks", "header_only", "fingerprint_only"] },
        "textualHunk": { "type": ["string", "null"] },
        "contextLines": { "type": "integer", "minimum": 0 },
        "omittedBaseLines": { "type": "integer", "minimum": 0 },
        "omittedTargetLines": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "baseContentHash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "targetContentHash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "textMode": { "const": "fingerprint_only" } } },
          "then": { "properties": { "textualHunk": { "const": null }, "contextLines": { "const": 0 } } }
        },
        {
          "if": { "properties": { "textMode": { "const": "header_only" } } },
          "then": { "properties": { "textualHunk": { "type": "string" }, "contextLines": { "const": 0 } } }
        },
        {
          "if": { "properties": { "textMode": { "const": "line_hunks" } } },
          "then": { "properties": { "textualHunk": { "type": "string" } } }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "baseSymbolId", "targetSymbolId", "baseLocations", "targetLocations", "evidence", "matchConfidence"],
      "properties": {
        "kind": { "enum": ["added", "deleted", "renamed", "rename_candidate", "signature_changed", "body_changed", "remark_changed", "formatting_only"] },
        "baseSymbolId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/symbolId" },
            { "type": "null" }
          ]
        },
        "targetSymbolId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/symbolId" },
            { "type": "null" }
          ]
        },
        "baseLocations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/location" } },
        "targetLocations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/location" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "matchConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
